<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="market_tag_view_list" model="ir.ui.view">
        <field name="name">market.tag.list</field>
        <field name="model">market.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="market_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">market.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
