<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="market_listing_view_list" model="ir.ui.view">
        <field name="name">market.listing.list</field>
        <field name="model">market.listing</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="price"/>
                <field name="condition"/>
                <field name="seller_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="market_listing_view_form" model="ir.ui.view">
        <field name="name">market.listing.form</field>
        <field name="model">market.listing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'available'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Used bicycle"/></h1>
                    </div>
                    <group>
                        <field name="category_id"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                        <field name="price"/>
                        <field name="best_offer"/>
                        <field name="condition"/>
                        <field name="is_negotiable"/>
                        <field name="seller_id"/>
                    </group>
                    <group string="Sale" invisible="state != 'sold'">
                        <field name="buyer_id"/>
                        <field name="selling_price"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state != 'available'">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <button name="action_accept" type="object" icon="check" title="Accept" invisible="parent.state != 'available'"/>
                                    <button name="action_refuse" type="object" icon="close" title="Refuse" invisible="parent.state != 'available'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="market_listing_view_search" model="ir.ui.view">
        <field name="name">market.listing.search</field>
        <field name="model">market.listing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter string="New" name="new" domain="[('condition', '=', 'new')]"/>
                <filter string="Like New" name="like_new" domain="[('condition', '=', 'like_new')]"/>
                <filter string="Used" name="used" domain="[('condition', '=', 'used')]"/>
                <separator/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Sold" name="sold" domain="[('state', '=', 'sold')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter string="Condition" name="group_by_condition" context="{'group_by': 'condition'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="market_listing_action" model="ir.actions.act_window">
        <field name="name">Listings</field>
        <field name="res_model">market.listing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_available": 1}</field>
    </record>
</odoo>
