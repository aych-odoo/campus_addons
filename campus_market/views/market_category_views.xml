<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="market_category_view_list" model="ir.ui.view">
        <field name="name">market.category.list</field>
        <field name="model">market.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="market_category_view_form" model="ir.ui.view">
        <field name="name">market.category.form</field>
        <field name="model">market.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="market_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">market.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
